# Disable LangSmith tracing (enabled by default in LangChain v1)
# Set to true and add LANGCHAIN_API_KEY to enable full traces at smith.langchain.com
LANGCHAIN_TRACING_V2=false

# Ollama model name — must match a model pulled in your Ollama instance
MODEL_NAME=qwen3.5:0.8b
ENABLE_REASONING=false

# Agent settings
AGENT_VERBOSE=false          # set to true to see the agent's step-by-step graph execution
AGENT_MAX_ITERATIONS=10      # maps to LangGraph recursion_limit (max graph steps)

# Base URL of the Ollama server
# Local: http://localhost:11434
# In-cluster (K8s sidecar): http://localhost:11434
# In-cluster (dedicated Ollama service): http://ollama-service:11434
OLLAMA_BASE_URL=http://localhost:11434

# FastAPI server settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# MCP server connections (JSON dict keyed by server name).
# Each server entry must be a valid langchain-mcp-adapters connection config.
#
# HTTP/Streamable-HTTP server:
#   MCP_SERVERS={"myserver": {"transport": "http", "url": "http://localhost:9000/mcp"}}
#
# Optional Weather MCP server:
#   MCP_SERVERS={"weather": {"transport": "http", "url": "http://localhost:8001/mcp"}}
#
# HTTP server with auth header:
#   MCP_SERVERS={"myserver": {"transport": "http", "url": "http://localhost:9000/mcp", "headers": {"Authorization": "Bearer TOKEN"}}}
#
# stdio (local subprocess) server:
#   MCP_SERVERS={"myserver": {"transport": "stdio", "command": "python", "args": ["/path/to/server.py"]}}
#
# Multiple servers:
#   MCP_SERVERS={"search": {"transport": "http", "url": "http://localhost:9001/mcp"}, "math": {"transport": "http", "url": "http://localhost:9002/mcp"}}
MCP_SERVERS={}
